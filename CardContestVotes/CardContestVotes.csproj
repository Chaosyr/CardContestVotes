<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>netframework4.7.2;netframework4.8;netframework4.8.1;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
        <RuntimeIdentifiers>win-x64;win-x86;win-arm64;linux-x64;linux-arm;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64</RuntimeIdentifiers>
        <AssemblyName>Card Contest Placing Calculator</AssemblyName>
        <Description>A calculator for the Card Contest placings.</Description>
        <Version>1.0.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>Latest</LangVersion>
        <RootNamespace>CardContestVotes</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <NoWarn>$(NoWarn);AD0001;CS0612;CS0618;CS8600;CS8604;Publicizer001;NETSDK1138</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Cecil.ANSI_Utils" Version="2.0.0" />
    </ItemGroup>

    <!--Build System Properties-->
    <PropertyGroup>
        <!--Copy Locations-->
        <BuildCopyLocations>Thunderstore-Package-Elements</BuildCopyLocations>
        <CHANGELOGCopyLocation>CHANGELOG.md</CHANGELOGCopyLocation>
        <READMECopyLocation>README.md</READMECopyLocation>
        <LICENSECopyLocation>LICENSE.md</LICENSECopyLocation>
        <ReleaseMode>Release</ReleaseMode>
        <!--Thunderstore Manifest Properties-->
        <ThunderstorePackageName>Card_Contest_Placing_Calculator</ThunderstorePackageName>
        <ThunderstorePackageVersion>1.0.0</ThunderstorePackageVersion>
        <ThunderstoreWebsiteURL>https://fanscryption.com</ThunderstoreWebsiteURL>
        <ThunderstorePackageDescription>A calculator for the Card Contest placings.</ThunderstorePackageDescription>
    </PropertyGroup>
</Project>